# Development wrapper for the announce executable.
# Loads the bundle, then delegates to the announce in
# ratatui_ruby-devtools. That one runs only as the program itself, so
# this replaces the process with it instead of loading it.

require "bundler/setup"
exec Gem.bin_path("ratatui_ruby-devtools", "announce"), *ARGV
